---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectListing from '../../components/ProjectListing.astro';
const category = (await getCollection('categories')).find(item => item.id === 'commercial');
const label = category?.data.label ?? 'Comerciales';
---
<SiteLayout title={`Proyectos ${label.toLowerCase()}`} description={`Explora proyectos de la categoría ${label.toLowerCase()} de Camila Guevara.`}>
  <ProjectListing category="commercial" />
</SiteLayout>
