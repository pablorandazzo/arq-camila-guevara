---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import JournalListing from '../../components/JournalListing.astro';
import ContentSections from '../../components/ContentSections.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const categories = ['newsletters', 'updates', 'commercial', 'resorts'];
  return [...articles.map(article => ({ params: { id: article.id }, props: { article } })),
    ...categories.map(category => ({ params: { id: category }, props: { category } }))];
}
const { article, category } = Astro.props;
---
<SiteLayout title={article ? article.data.title : 'Diario'} description={article ? article.data.summary || article.data.title : 'Ideas, noticias y reflexiones sobre arquitectura y diseño desde Studio RHE.'}>
  {category && <JournalListing category={category} />}
  {article && <main class="page article-detail"><h1 class="detail-heading">{article.data.title}</h1><img src={article.data.image} alt={article.data.alt} />{article.data.summary && <p>{article.data.summary}</p>}<ContentSections sections={article.data.sections} />{article.data.originalSlug && <a class="text-link" href={`https://www.studiorhe.com/article/${article.data.originalSlug}`} target="_blank" rel="noreferrer">Leer el artículo completo en la web original</a>}<a class="text-link" href="/journal/">Volver al diario</a></main>}
</SiteLayout>
