---
import { getCollection } from 'astro:content';
import ContentSections from './ContentSections.astro';
import type { SiteSection } from '../lib/site-schema';
import { imageProps, mobileHeroSource } from '../lib/images';

interface Props {
  sections: SiteSection[];
  context: 'home' | 'contact';
}
const { sections, context } = Astro.props;
const projects = sections.some(section => section.type === 'home_projects') ? await getCollection('projects') : [];
const featuredProjects = (ids: string[]) => ids.map(id => {
  const project = projects.find(item => item.id === id);
  if (!project) throw new Error(`Featured project does not exist: ${id}`);
  return project;
});
---
{sections.map(section => section.type === 'home_hero'
  ? <section class="home-hero"><picture>{mobileHeroSource(section.image) && <source media="(max-width: 768px)" srcset={mobileHeroSource(section.image)?.src} type="image/avif" />}<img {...imageProps(section.image, '100vw')} alt={section.alt} fetchpriority="high" decoding="async" /></picture><div class="home-hero-content"><h1 class="hero-title" aria-label={section.title}><span class="hero-title-line">{section.title.split(/\s+/)[0]}</span>{' '}<span class="hero-title-line">{section.title.split(/\s+/).slice(1).join(' ')}</span></h1><div class="home-hero-actions" aria-label="Acciones principales"><a class="home-hero-button" href="/contact/">Contactarme</a></div></div></section>
  : section.type === 'home_about'
     ? <section class="home-about" aria-labelledby="home-about-label"><h2 id="home-about-label" class="section-label">{section.label}</h2><img {...imageProps(section.image, '100vw')} alt={section.alt} loading="lazy" decoding="async" /><div class="home-about-copy"><h3 class="editorial-title">{section.title}</h3><p>{section.text}</p><a class="text-link" href="/perfil/">Mi perfil</a></div></section>
    : section.type === 'home_projects'
    ? <section class="home-featured-projects"><div class="project-strip">{featuredProjects(section.featuredProjects).map(project => <article><a href={`/projects/${project.id}/`}><div class="card-image"><img {...imageProps(project.data.image, '(max-width: 768px) 100vw, 40vw')} alt={project.data.alt} loading="lazy" decoding="async" /></div><div class="card-caption"><h3>{project.data.title}</h3><span class="text-link">{section.projectLinkLabel}</span></div></a></article>)}</div><div class="home-featured-heading"><h2 class="section-label">Proyectos</h2><a class="text-link" href="/projects/">Ver todos los proyectos</a></div></section>
    : section.type === 'contact_details'
      ? <section class="contact-view" aria-labelledby="contact-heading">
          <div class="contact-left">
            <div class="contact-identity">
              <h1 id="contact-heading">{section.heading}</h1>
              <p>{section.qualification}</p>
            </div>
            <div class="contact-main">
              <p class="editorial-title">{section.statement}</p>
              <button class="contact-cta" type="button" data-open-contact>{section.cta}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></button>
            </div>
            <div class="contact-details">
              <h2>{section.detailsLabel}</h2>
              <address>
                <div><span>Mail</span><a href={`mailto:${section.email}`}>{section.email}</a></div>
                <div><span>Cel</span><a href={`tel:${section.phoneHref}`}>{section.phoneDisplay}</a></div>
                <div><span>LinkedIn</span><a href={section.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></div>
              </address>
            </div>
          </div>
          <div class="contact-image-frame"><img class="contact-image" {...imageProps(section.image, '(max-width: 768px) 100vw, 44vw')} alt={section.imageAlt} decoding="async" /></div>
        </section>
       : <ContentSections sections={[section]} context={context === 'home' ? 'home' : 'page'} />
)}
