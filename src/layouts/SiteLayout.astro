---
import site from '../lib/site';
const { title, description, home = false, lightLogo = false, navigation = true, wordmark = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <title>{title} — {site.brand}</title>
    <link rel="preload" href="/assets/fonts/Reckless-Light.c765955.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/site.css" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body class:list={{ 'home-page': home }}>
    {navigation && <>
       <a class:list={['logo', { 'is-light': lightLogo }]} href="/" aria-label={`${site.brand}, inicio`}><img src="/assets/logo.svg" alt={site.brand} width="75" height="77" />{wordmark && <span class="project-detail-wordmark" aria-hidden="true">{site.brand}</span>}</a>
      <header class="site-rail"><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-menu"><span></span><span></span><span></span></button><span class="rail-est">{site.established}</span><span class="rail-progress"><span id="scroll-progress">0</span>%</span></header>
      <div class="menu-shade" id="menu-shade"></div>
       <aside class="main-menu" id="main-menu" aria-label="Menú principal" inert><nav>{['/about/', '/projects/', '/journal/', '/contact/'].map((url, i) => <a class="menu-link" href={url}>{site.menu[i]}</a>)}<div class="menu-meta"><a class="text-link" href="/privacy/">{site.privacyLabel}</a><a class="text-link" href={site.creditUrl} target="_blank" rel="noreferrer">{site.creditLabel}</a></div></nav></aside>
       <noscript><nav class="nojs-nav" aria-label="Menú principal"><a href="/" aria-label="Inicio">{site.brand}</a>{['/about/', '/projects/', '/journal/', '/contact/'].map((url, i) => <a href={url}>{site.menu[i]}</a>)}</nav><style>.site-rail,.logo{display:none}</style></noscript>
    </>}
    <slot />
    <script src="/assets/interaction.js" defer></script>
  </body>
</html>
