---
import { ClientRouter } from 'astro:transitions';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import site from '../lib/site';

// The stylesheet ships inside the document so the first paint does not wait for a
// render-blocking request. Font URLs inside it are absolute and resolve from the site root.
// Resolve from the build root: this module is bundled before the copy step runs.
const siteCss = readFileSync(resolve(process.cwd(), 'assets/site.css'), 'utf8');
const { title, description, home = false, navigation = true } = Astro.props;
const destinations = { home: '/', cv: '/perfil/', projects: '/projects/', contact: '/contact/' };
const navItems = site.menu.map(item => ({ label: item.label, href: destinations[item.id], external: false }));
const menuLabel = (id: 'home' | 'cv' | 'projects' | 'contact') => site.menu.find(item => item.id === id)?.label;
const onContact = Astro.url.pathname.startsWith('/contact');
const onProjects = Astro.url.pathname.startsWith('/projects');
const footerPrimary = onContact
  ? { label: menuLabel('projects'), href: '/projects/' }
  : { label: menuLabel('contact'), href: '/contact/' };
const footerSecondary = onContact || onProjects
  ? { label: menuLabel('home'), href: '/' }
  : { label: menuLabel('projects'), href: '/projects/' };
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <title>{title} — {site.brand}</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('rhe-entry-played') === '1') document.documentElement.dataset.homeEntryPlayed = 'true';
      } catch {}
    </script>
    <link rel="preload" href="/assets/fonts/Reckless-Light.c765955.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={siteCss}></style>
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class:list={{ 'home-page': home, 'header-over-hero': home }}>
    {home && <>
      <div class="entry-mask" id="entry-mask" aria-hidden="true"><span></span><span></span><span></span></div>
      <noscript><style>.entry-mask{display:none!important}.home-hero picture img,.home-hero .hero-character,.home-hero .hero-intro{animation-play-state:running!important}</style></noscript>
    </>}
    {navigation && <>
      <a class:list={['logo', { 'is-light': home }]} href="/" aria-label={`Inicio: ${site.brand}`}><svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M4 44V4h40v40H4Z"/><path d="M4 16h19v28M23 4v12h21M23 30h21M12 16v12h11M12 28v16M23 30v14M30 30v14M30 37h14"/></svg><span class="logo-copy"><span>{site.brand}</span><small>ARQUITECTA</small></span></a>
      <header class="site-rail"><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-menu"><span></span><span></span><span></span></button><span class="rail-progress"><span id="scroll-progress">0</span>%</span></header>
      <div class="menu-shade" id="menu-shade"></div>
      <aside class="main-menu" id="main-menu" aria-label="Menú principal" inert><nav>{navItems.map(item => item.href ? <a class="menu-link" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}><span class="menu-link-label"><span>{item.label}</span></span></a> : <span class="menu-link menu-link--disabled" aria-disabled="true" title="El archivo de CV todavía no está disponible"><span class="menu-link-label"><span>{item.label}</span></span></span>)}<div class="menu-meta"><a class="text-link" href={site.creditUrl} target="_blank" rel="noreferrer">{site.creditLabel}</a></div></nav></aside>
      <noscript><nav class="nojs-nav" aria-label="Menú principal">{navItems.map(item => item.href ? <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a> : <span aria-disabled="true">{item.label}</span>)}</nav><style>.site-rail{display:none}</style></noscript>
    </>}
    <slot />
    {navigation && <footer class="mobile-footer">
      <p class="mobile-footer-brand">{site.brand}</p>
      <nav class="mobile-footer-nav" aria-label="Accesos rápidos">
        <a class="mobile-footer-primary" href={footerPrimary.href}>{footerPrimary.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a class="mobile-footer-secondary" href={footerSecondary.href}>{footerSecondary.label}</a>
        {site.cv && <a class="mobile-footer-secondary" href={site.cv} target="_blank" rel="noopener noreferrer">CV</a>}
      </nav>
    </footer>}
    <script src="/assets/interaction.js" defer data-astro-rerun></script>
    <script>import '../scripts/project-transitions.js';</script>
  </body>
</html>
